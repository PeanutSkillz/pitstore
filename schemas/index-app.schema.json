{
  "$id": "index-app",
  "description": "One app entry of index.json. icon/thumbnail are checked in code and dropped when they are not app-local paths.",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "compose_url",
    "meta_url",
    "content_hash"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/app_id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tagline": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "categories": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "author": {
      "type": "string",
      "maxLength": 200
    },
    "developer": {
      "type": "string",
      "maxLength": 200
    },
    "architectures": {
      "$ref": "#/$defs/architectures"
    },
    "icon": {
      "type": "string",
      "maxLength": 512
    },
    "thumbnail": {
      "type": "string",
      "maxLength": 512
    },
    "compose_url": {
      "$ref": "#/$defs/store_path"
    },
    "meta_url": {
      "$ref": "#/$defs/store_path"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,128}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "$defs": {
    "app_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9_-]+)+$"
    },
    "store_path": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^/apps/[a-z0-9._-]+/[A-Za-z0-9._/-]+$"
    },
    "architectures": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]{1,16}$"
      }
    }
  }
}
