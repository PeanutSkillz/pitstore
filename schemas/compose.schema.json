{
  "$id": "compose",
  "description": "Structural shape of a built catalog Compose file. The security policy (src/lib/policy.ts, helper/pitstore/policy.py) decides which keys are allowed.",
  "type": "object",
  "required": [
    "services",
    "x-casaos"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "x-casaos": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9_-]+)+$"
        },
        "main": {
          "type": "string",
          "maxLength": 63
        },
        "index": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512,
          "pattern": "^(/[^\\s]*)?$"
        },
        "port_map": {
          "type": "string",
          "pattern": "^([0-9]{1,5})?$"
        },
        "scheme": {
          "enum": [
            "http",
            "https",
            ""
          ]
        },
        "version": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  }
}
