#!/usr/bin/make -f
# SPDX-License-Identifier: LGPL-2.1-or-later

%:
	dh $@

# dist/ is built beforehand with `make` (needs node and network);
# the package build itself only installs it
override_dh_auto_build:
	test -f dist/manifest.json

override_dh_auto_test:

# keep the prebuilt dist/; `make clean` would delete it
override_dh_auto_clean:

override_dh_auto_install:
	$(MAKE) install-dist DESTDIR=$(CURDIR)/debian/pitstore PREFIX=/usr
