 {
  "description": "sensitive host paths, normalized",
  "compose": {
   "name": "demo",
   "services": {
    "web": {
     "image": "nginx:1.27",
     "volumes": [
      "/:/host",
      "/etc:/etc:ro",
      "//etc/../etc/:/e",
      "/root/.ssh:/ssh",
      "/var/run:/var/run",
      "/var:/v",
      "/proc/1:/p",
      "/var/lib/docker/volumes:/dv",
      "/sys/fs/cgroup:/cg",
      "/boot:/b",
      "/dev:/dev"
     ]
    }
   },
   "x-casaos": {
    "id": "org.example.demo",
    "main": "web",
    "port_map": "8080"
   }
  },
  "findings": [
   "web/mount-sensitive:/",
   "web/mount-sensitive:/boot",
   "web/mount-sensitive:/dev",
   "web/mount-sensitive:/etc",
   "web/mount-sensitive:/proc/1",
   "web/mount-sensitive:/root/.ssh",
   "web/mount-sensitive:/sys/fs/cgroup",
   "web/mount-sensitive:/var",
   "web/mount-sensitive:/var/lib/docker/volumes",
   "web/mount-sensitive:/var/run"
  ],
  "unsupported": []
 },
